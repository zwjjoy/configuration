#!/bin/bash
# Re-runs whenever the Brewfile changes. Brewfile hash: {{ include "../Brewfile" | sha256sum }}
set -euo pipefail
eval "$(/opt/homebrew/bin/brew shellenv)"
export NVM_DIR="$HOME/.nvm"
. "$NVM_DIR/nvm.sh" # puts npm on PATH for the npm entries
brew bundle install --no-upgrade --file={{ joinPath .chezmoi.workingTree "Brewfile" | quote }}
