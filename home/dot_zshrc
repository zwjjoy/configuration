# mic warm
micwarm() {
  local plist label
  plist=$(ls ~/Library/LaunchAgents 2>/dev/null | grep -i 'mic.*warm.*\.plist$' | head -1)
  if [[ -z "$plist" ]]; then
    echo "micwarm: LaunchAgent not found in ~/Library/LaunchAgents" >&2
    return 1
  fi
  label="${plist%.plist}"

  _micwarm_running() { launchctl print "gui/$(id -u)/$label" &>/dev/null }

  case "$1" in
    on)
      _micwarm_running && { echo "already warm"; return 0 }
      launchctl bootstrap "gui/$(id -u)" ~/Library/LaunchAgents/"$plist" && echo "mic warm 🔥"
      ;;
    off)
      _micwarm_running || { echo "already off"; return 0 }
      launchctl bootout "gui/$(id -u)/$label" && echo "mic cold ❄️"
      ;;
    toggle|"")
      _micwarm_running && micwarm off || micwarm on
      ;;
    status)
      _micwarm_running && echo "on ($label)" || echo "off ($label)"
      ;;
    *)
      echo "usage: micwarm [on|off|toggle|status]" >&2
      return 1
      ;;
  esac
}

# displaysleep
alias dsleep='pmset displaysleepnow'

# markserve
ms() {
  local port=8000

  while lsof -nP -iTCP:"$port" -sTCP:LISTEN -t >/dev/null; do
    ((port++))
  done

  echo "Starting markserv on http://localhost:$port"
  npx markserv --address 0.0.0.0 --port "$port" "$@"
}

